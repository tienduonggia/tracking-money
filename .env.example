# Postgres connection string (Neon / Supabase / Postgres tự host)
DATABASE_URL=postgres://user:pass@host:5432/db?sslmode=require

# Token của bot lấy từ @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...
# Username của bot (không có @), dùng cho nút đăng nhập Telegram trên website
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=so_tai_san_bot

# (tuỳ chọn) short name của Mini App tạo bằng /newapp — để link t.me/<bot>/<app>?startapp=... tự điền mã đăng nhập
NEXT_PUBLIC_TELEGRAM_APP_SHORTNAME=

# Danh sách Telegram user id được phép đăng nhập, cách nhau bởi dấu phẩy
# (để trống thì không ai vào được; lần đầu đăng nhập app sẽ hiện id của bạn)
ALLOWED_TELEGRAM_IDS=

# Chuỗi ngẫu nhiên >= 32 ký tự để ký phiên đăng nhập: openssl rand -hex 32
SESSION_SECRET=

# Vercel tự gửi header Authorization: Bearer <CRON_SECRET> khi chạy cron
CRON_SECRET=

# (tuỳ chọn) CoinGecko demo API key để lấy giá coin ổn định hơn
COINGECKO_API_KEY=
